# ====================================================================
# SecureShare Environment Configuration Example
# ====================================================================

# AWS Region (default: us-east-1)
AWS_REGION=us-east-1

# S3 Document Bucket Name
# For AWS deployment, bucket names must be globally unique
S3_BUCKET_NAME=secureshare-documents

# DynamoDB Sharing Metadata Table
DYNAMODB_TABLE_NAME=ShareLinks

# Optional: Frontend domain URL (used to generate sharing links matching your frontend host)
# Example: https://secureshare.vercel.app
FRONTEND_URL=

# Optional: API Gateway Base URL
# Example: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
API_BASE_URL=

# --------------------------------------------------------------------
# Local Development Only (Omit or leave blank for AWS Cloud deployment)
# --------------------------------------------------------------------
# S3_ENDPOINT_URL=http://127.0.0.1:5001
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

